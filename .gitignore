# =============================================================================
# TAURI & DESKTOP APP
# =============================================================================
# Tauri build output
apps/desktop/src-tauri/target/

# OCCT DLLs for Windows bundling (generated by copy-dlls.ps1)
apps/desktop/src-tauri/resources/occt-dlls/*
!apps/desktop/src-tauri/resources/occt-dlls/.gitkeep

# OCCT dylibs for macOS bundling (generated by copy-dylibs-macos.sh)
apps/desktop/src-tauri/frameworks/

# WiX installer artifacts (Windows)
*.wixpdb
*.wixobj
*.msi

# macOS bundle artifacts
*.app/
*.dmg

# Windows installer
*.exe
!scripts/*.exe

# Debug symbols
*.pdb
*.dSYM/

